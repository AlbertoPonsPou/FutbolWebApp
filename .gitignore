# Compilacion, depuracion y archivos temporales de DataFlex
*.exe
*.dll
*.dbg
*.pdb
*.prn
*.dep
*.log
*.cch
*.dfr
*.bak
*.tmp
*.loc
/IdeSrc/
/AppSrc/config/classlist.xml

# Motor y temas originales: se copian desde la instalacion de DataFlex
/AppHtml/DfEngine/
/AppHtml/CssThemes/

# Credenciales, claves y configuracion local
DFConn*.ini
dfconn*.ini
/AppSrc/LoginEncryptionKey.inc
/AppSrc/WebAppEncryptionKey.inc
.env
.env.*
!.env.example

# Datos locales de las tablas embebidas (incluyen sesiones de usuarios)
# scripts/Initialize-Local.ps1 restaura las tablas iniciales al clonar.
/Data/*.dat
/Data/*.hdr
/Data/*.k[0-9]*

# Archivos del sistema y editores
Thumbs.db
Desktop.ini
.DS_Store
.vs/
.idea/
.vscode/
