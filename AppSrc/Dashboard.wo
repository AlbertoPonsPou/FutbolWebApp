Use SelectEntrenador.wo
Use SelectJugador.wo
Use SelectPosicion.wo
Use SelectEquipo.wo
Use SelectLiga.wo
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg

Object oDashboard is a cWebView
    Set piMaxWidth to 1024
    Set psCaption to "Inicio"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oWelcome is a cWebHtmlBox
            Set piColumnSpan to 12
            Set psCSSClass to "FootballHero"
            Set psHtml to '<section><span class="eyebrow">TU CLUB, EN ORDEN</span><h1>Gestion de futbol</h1><p>Organiza tus ligas, equipos y jugadores.<br>Todo lo que necesitas, en un mismo lugar.</p></section>'
        End_Object

        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 0
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            Object oEntrenadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Light"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="FootballTileIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="7" r="3"/><path d="M5 21v-3a7 7 0 0 1 14 0v3M8 14l4 4 4-4"/></svg></span><span class="Tile_Title">Entrenadores</span><span class="Tile_Subtitle">Consultar y gestionar entrenadores</span><span class="FootballTileLink" aria-hidden="true">Abrir seccion &#8594;</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oJugadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="FootballTileIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="7" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3M16 4a3 3 0 0 1 0 6M18 14a6 6 0 0 1 3 5v2"/></svg></span><span class="Tile_Title">Jugadores</span><span class="Tile_Subtitle">Consultar y gestionar jugadores</span><span class="FootballTileLink" aria-hidden="true">Abrir seccion &#8594;</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectJugador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oPosicionTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 8
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="FootballTileIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 12h18M12 3v18"/><circle cx="12" cy="12" r="3"/></svg></span><span class="Tile_Title">Posiciones</span><span class="Tile_Subtitle">Consultar y gestionar posiciones</span><span class="FootballTileLink" aria-hidden="true">Abrir seccion &#8594;</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oEquipoTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="FootballTileIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 5-8 9-8 9s-8-4-8-9V6z"/><path d="M8 12l3 3 5-6"/></svg></span><span class="Tile_Title">Equipos</span><span class="Tile_Subtitle">Consultar y gestionar equipos</span><span class="FootballTileLink" aria-hidden="true">Abrir seccion &#8594;</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oLigaTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Light"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="FootballTileIcon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3h8v5a4 4 0 0 1-8 0zM8 5H4v3a4 4 0 0 0 4 4M16 5h4v3a4 4 0 0 1-4 4M12 12v6M8 21h8M9 18h6"/></svg></span><span class="Tile_Title">Ligas</span><span class="Tile_Subtitle">Consultar y gestionar ligas</span><span class="FootballTileLink" aria-hidden="true">Abrir seccion &#8594;</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectLiga

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object
        End_Object
    End_Object
End_Object
