Use SelectEntrenador.wo
Use SelectJugador.wo
Use SelectPosicion.wo
Use SelectEquipo.wo
Use SelectLiga.wo
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebGroup.pkg
Use cWebHtmlBox.pkg

Object oDashboard is a cWebView
    Set piMaxWidth to 1024
    Set psCaption to "Futbol"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 0
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            Object oEntrenadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Light"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="Tile_Title">Entrenadores</span><span class="Tile_Subtitle">Consultar y gestionar entrenadores</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectEntrenador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oJugadorTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="Tile_Title">Jugadores</span><span class="Tile_Subtitle">Consultar y gestionar jugadores</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectJugador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oPosicionTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 8
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="Tile_Title">Posiciones</span><span class="Tile_Subtitle">Consultar y gestionar posiciones</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oEquipoTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 0
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="Tile_Title">Equipos</span><span class="Tile_Subtitle">Consultar y gestionar equipos</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            Object oLigaTile is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 4
                Set piColumnIndex to 4
                WebSetResponsive piColumnSpan rmMobile to 12
                WebSetResponsive piColumnIndex rmMobile to 0
                Set psCSSClass to "Tile Light"
                Set psHtml to '<button type="button" class="WebCon_Sizer FootballTileContent" data-ServerOnClick="openview"><span class="Tile_Title">Ligas</span><span class="Tile_Subtitle">Consultar y gestionar ligas</span></button>'

                WebRegisterPath ntNavigateForwardCustom oSelectLiga

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object
        End_Object
    End_Object
End_Object
